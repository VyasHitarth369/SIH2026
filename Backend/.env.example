# Concordia / Samadhan Setu Backend Environment Template
# NEVER commit real production secrets or API keys to version control.

# Supabase Project Configuration
SUPABASE_URL=https://your-project-id.supabase.co
# Server-side Service Role Secret Key (MUST NEVER BE EXPOSED TO FRONTEND)
SUPABASE_SECRET_KEY=your-supabase-service-role-secret-key-here
# Legacy fallback (optional)
# SUPABASE_KEY=your-supabase-service-role-secret-key-here

# LLM / AI Configuration (Max 2 calls per challenge)
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.5-flash

# Secondary LLM Configuration (OpenAI Fallback - BACKEND ONLY)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-5.6-luna

# Server Environment
ENVIRONMENT=development
PORT=8000
